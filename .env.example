# Copy to .env (never commit .env) or set these in your host's environment.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app creates .secret_key in DATA_DIR on first run.
SECRET_KEY=

# Folder for the databases, sessions and secret key. Defaults to the app folder.
DATA_DIR=

# First admin account, created only when there are no users yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to 1 ONLY for local development over plain http://
FLASK_INSECURE_COOKIES=
